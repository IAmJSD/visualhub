<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- @VERSION@ and @MIN_MACOS@ are filled in by bundle.sh, from Cargo.toml
     and the deployment target the binary was built for. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>VisualHub</string>
    <key>CFBundleDisplayName</key><string>VisualHub</string>
    <key>CFBundleIdentifier</key><string>com.infrawrench.visualhub</string>
    <key>CFBundleVersion</key><string>@VERSION@</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleExecutable</key><string>visualhub</string>
    <key>CFBundleIconFile</key><string>visualhub</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
    <key>LSMinimumSystemVersion</key><string>@MIN_MACOS@</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSHumanReadableCopyright</key><string>MIT licensed.</string>
</dict>
</plist>
