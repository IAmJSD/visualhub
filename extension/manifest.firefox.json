{
  "manifest_version": 3,
  "name": "VisualHub",
  "version": "@VERSION@",
  "description": "Open the GitHub, GitLab or Bitbucket page you're on in VisualHub.",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "VisualHub can't open this page",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "background": {
    "scripts": ["hosts.js", "supported.js", "background.js"]
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["*://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "visualhub@infrawrench.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
